{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TaskManagementSystem",
    "Audience": "TaskManagementSystem",
    "ExpiresMinutes": 15
  },
  "RefreshToken": {
    "ExpiresDays": 7,
    "ReuseGraceSeconds": 10
  },
  "LoginProtection": {
    "MaxFailedAttempts": 5,
    "FailureWindowSeconds": 60
  }
}
