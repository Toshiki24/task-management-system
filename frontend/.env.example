# BFF(Next.jsのサーバー側)から呼び出すバックエンドAPIのベースURL。ブラウザには公開されない
API_BASE_URL=http://localhost:5000/api

# セッションCookieの暗号化に使う32文字以上のランダムな文字列。
# 例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" で生成する
# 本番環境では必ず別の値を環境変数で設定すること(この例の値は使わない)
SESSION_SECRET=local-development-only-session-secret-change-me-0123456789
