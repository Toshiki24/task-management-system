# 自己ホスト(docker-compose.selfhost.yml)用の環境変数サンプル(M5 §8)。
#   cp .env.selfhost.example .env.selfhost
# として値を設定し、本ファイル(サンプル)はコミットしてよいが .env.selfhost はコミットしないこと。
# 秘密情報は 32 文字以上のランダム文字列を推奨。例: openssl rand -base64 36

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please-strong-password
POSTGRES_DB=task_management

# --- API(バックエンド)---
# JWT 署名鍵(32文字以上)。必須。
JWT_KEY=change-me-32-chars-minimum-random-string-0123456789
# TOTP シークレットの暗号化鍵(未設定なら JWT_KEY を流用)。任意。
MFA_KEY=

# --- BFF/API 共有 ---
# BFF からの呼び出しを確認する共有シークレット(API と web で同一値)。必須。
ORIGIN_VERIFY_SECRET=change-me-32-chars-minimum-random-string-abcdefghij

# --- フロント/BFF ---
# セッション Cookie 暗号化キー(32文字以上)。必須。
SESSION_SECRET=change-me-32-chars-minimum-random-string-klmnopqrst
# 公開ポート(リバースプロキシからの転送先。既定では 127.0.0.1 のみに公開)
WEB_PORT=3000

# 初期管理者は環境変数では設定しない。初回起動後にブラウザのセットアップ画面(/setup)から作成する。
# (SELF_HOST_SETUP はセキュリティ上 compose 側で "true" を設定済み)

# --- メール送信(招待メール等) ---
# SMTP_HOST を設定すると実送信、未設定なら送信内容をログ出力するだけ(招待リンクはログで確認)。
# 標準的な SMTP(25 / 587 STARTTLS + 認証)に対応。Gmail・Amazon SES(SMTP)・SendGrid・Mailgun 等で利用可。
# 例(Gmail): SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=you@gmail.com / SMTP_PASSWORD=<アプリパスワード>
# 例(Amazon SES): SMTP_HOST=email-smtp.<region>.amazonaws.com / SMTP_PORT=587 / SMTP_USER=<SMTPユーザー> / SMTP_PASSWORD=<SMTPパスワード>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 送信元アドレス(未設定なら SMTP_USER を使用)。多くのプロバイダは認証ユーザーと同じドメインを要求する。
SMTP_FROM=
SMTP_FROM_NAME=タスク管理システム
# STARTTLS を使うか(587 は true、平文25のみは false)。465 の暗黙TLSのみのサーバーは未対応のため 587 を推奨。
SMTP_USE_STARTTLS=true

# 招待メール内リンクを絶対URLにするための公開URL(例: https://tasks.example.com)。
# 未設定だと相対パス(/invitations/accept?token=...)になります。
APP_BASE_URL=
