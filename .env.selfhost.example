# 自己ホスト(docker-compose.selfhost.yml)用の環境変数サンプル(M5 §8)。
#   cp .env.selfhost.example .env.selfhost
# として値を設定し、本ファイル(サンプル)はコミットしてよいが .env.selfhost はコミットしないこと。
# 秘密情報は 32 文字以上のランダム文字列を推奨。例: openssl rand -base64 36

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please-strong-password
POSTGRES_DB=task_management

# --- API(バックエンド)---
# JWT 署名鍵(32文字以上)。必須。
JWT_KEY=change-me-32-chars-minimum-random-string-0123456789
# TOTP シークレットの暗号化鍵(未設定なら JWT_KEY を流用)。任意。
MFA_KEY=

# --- BFF/API 共有 ---
# BFF からの呼び出しを確認する共有シークレット(API と web で同一値)。必須。
ORIGIN_VERIFY_SECRET=change-me-32-chars-minimum-random-string-abcdefghij

# --- フロント/BFF ---
# セッション Cookie 暗号化キー(32文字以上)。必須。
SESSION_SECRET=change-me-32-chars-minimum-random-string-klmnopqrst
# 公開ポート(リバースプロキシからの転送先)
WEB_PORT=3000

# --- 初期 System Admin(任意。初回起動時のみ) ---
# EMAIL と PASSWORD の両方を設定すると、初回起動で冪等に作成される。作成後は外してよい。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
